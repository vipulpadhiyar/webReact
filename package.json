    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/react-native": "^12.5.1",
    "@types/jest": "^29.5.11",
    "@types/lodash": "^4.17.0",
    "@types/react": "^18.2.6",
    "@types/react-native-crypto-js": "^1.0.3",
    "@types/react-test-renderer": "^18.0.0",
