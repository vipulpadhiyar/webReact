{
  "name": "msrhorserowner",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "start": "react-native start",
    "test": "jest",
    "test new snaps": "jest --u",
    "jest:clean": "npx jest --clearCache",
    "reset": "npx react-native start --reset-cache",
    "coverage": "jest --coverage && open coverage/lcov-report/index.html",
    "pod": "npx pod-install ios",
    "pod:update": "cd ios && pod install --repo-update && cd ..",
    "android:clean": "cd android && ./gradlew clean",
    "ios:clean": "cd ios && pod deintegrate && rm -rf Podfile.lock",
    "xcw": "cd ios && xed *.xcworkspace",
    "clean:node_modules": "rm -rf node_modules && rm -rf yarn.lock",
    "link:assets": "npx react-native-asset",
    "android:dev": "KEYSFILE=./keys.development.json react-native run-android --mode=developmentdebug",
    "android:stg": "KEYSFILE=./keys.staging.json react-native run-android  --mode=stagingdebug",
    "android:prod": "KEYSFILE=./keys.production.json react-native run-android  --mode=productiondebug",
    "build:dev": "cd android && ./gradlew clean && KEYSFILE=./keys.development.json ./gradlew assembleDevRelease && open app/build/outputs/apk/dev/release",
    "build:stg": "cd android && ./gradlew clean && KEYSFILE=./keys.staging.json ./gradlew assembleStagRelease && open app/build/outputs/apk/stag/release",
    "build:prod": "cd android && ./gradlew clean && KEYSFILE=./keys.production.json ./gradlew assembleProdRelease && open app/build/outputs/apk/prod/release",
    "bundle:dev": "cd android && ./gradlew clean && KEYSFILE=./keys.development.json ./gradlew bundleDevRelease &&  open app/build/outputs/bundle/dev/release",
    "bundle:stg": "cd android && ./gradlew clean && KEYSFILE=./keys.staging.json ./gradlew bundleStagRelease  && open app/build/outputs/bundle/stag/release",
    "bundle:prod": "cd android && ./gradlew clean && KEYSFILE=./keys.production.json ./gradlew bundleProdRelease  && open app/build/outputs/bundle/prod/release",
    "ios:dev": "KEYSFILE=./keys.development.json react-native run-ios --scheme 'msrhorserownerDev' --simulator='iPhone 15'",
    "ios:stg": "KEYSFILE=./keys.staging.json react-native run-ios --scheme 'msrhorserownerStag' --simulator='iPhone 15'",
    "ios:prod": "KEYSFILE=./keys.production.json react-native run-ios --scheme 'msrhorserowner' --simulator='iPhone 15'"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^4",
    "@notifee/react-native": "^7.8.2",
    "@react-native-community/geolocation": "^3.3.0",
